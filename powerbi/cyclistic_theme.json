{
  "$schema": "https://powerbi.microsoft.com/schemas/theme/theme.json",
  "name": "Cyclistic Executive Modern Theme (Senior BI Architect Edition)",
  "dataColors": [
    "#1E40AF",
    "#EA580C",
    "#0D9488",
    "#4F46E5",
    "#DB2777",
    "#0284C7",
    "#059669",
    "#D97706",
    "#6366F1",
    "#64748B"
  ],
  "good": "#059669",
  "bad": "#DC2626",
  "neutral": "#64748B",
  "maximum": "#1E40AF",
  "center": "#F1F5F9",
  "minimum": "#EA580C",
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#1E40AF",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26,
      "color": "#0F172A"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#0F172A"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#334155"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#64748B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#F1F5F9" } },
            "foregroundColor": { "solid": { "color": "#0F172A" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "position": "Outer",
            "preset": "BottomRight",
            "transparency": 88
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foregroundColor": { "solid": { "color": "#64748B" } }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "label": [
          {
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI"
          }
        ],
        "accentBar": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E40AF" } },
            "position": "Left",
            "width": 4
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#0F172A" } },
            "backColor": { "solid": { "color": "#F1F5F9" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#334155" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#F1F5F9" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E2E8F0" } }
          }
        ]
      }
    }
  }
}
